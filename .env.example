# Datta Krushi Seva Kendra - Environment Configuration Template
# Copy this file to .env and fill in your actual API keys

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Gemini Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Default LLM Provider ('openai' or 'gemini')
DEFAULT_PROVIDER=openai

# Database Configuration (Optional - defaults to SQLite database/krushi_kendra.db)
DATABASE_URL=sqlite:///database/krushi_kendra.db
